
module readserial_properties (

    input logic clk,
    input logic reset_n,
    input logic rxd,
    input logic [7:0] data,
    input logic valid,
    input shortint unsigned cnt_s,
    input logic cnt_en,
    input logic state_s,
    input logic [7:0] data_i
);

    localparam IDLE = 1'b0;
    localparam READ_DATA = 1'b1;

    sequence sequenceReset;
        reset_n == 1'b0;
    endsequence

    sequence sequenceNoStartBit;
        state_s == IDLE && rxd == 1'b1;
    endsequence

    sequence sequenceStartCondition;
        state_s == IDLE && rxd == 1'b0;
    endsequence

    sequence in_idle_counter_is_0;
        state_s == IDLE && cnt_s == 0;
    endsequence

    sequence in_idle_counter_not_enabled;
        state_s == IDLE && cnt_en == 1'b0;
    endsequence

    property propertyReset;
        @(posedge clk)
        sequenceReset |=> state_s == IDLE && cnt_s == 0 && valid == 1'b0 && cnt_en == 1'b0;
    endproperty

    property propertyNoStartBit;
        @(posedge clk)
        sequenceNoStartBit |=> state_s == IDLE && valid == 0;
    endproperty

    property propertyCheckOutput;
        @(posedge clk) disable iff (!reset_n)
        (sequenceStartCondition and in_idle_counter_is_0 and in_idle_counter_not_enabled)
        |=> (state_s == READ_DATA && valid == 1'b0)
            ##1 valid == 1'b0
            ##1 valid == 1'b0
            ##1 valid == 1'b0
            ##1 valid == 1'b0
            ##1 valid == 1'b0
            ##1 valid == 1'b0
            ##1 valid == 1'b0
            ##1 (state_s == IDLE && valid == 1'b1 && 
                data == {$past(rxd, 8), $past(rxd, 7), $past(rxd, 6), $past(rxd, 5),
                         $past(rxd, 4), $past(rxd, 3), $past(rxd, 2), $past(rxd, 1)});
    endproperty

    property in_idle_counter_not_enabled__step;
        @(posedge clk) disable iff (!reset_n)
        in_idle_counter_not_enabled |-> in_idle_counter_not_enabled;
    endproperty

    property in_idle_counter_not_enabled__base;
        @(posedge clk)
        sequenceReset |=> in_idle_counter_not_enabled;
    endproperty

    assertReset: assert property (propertyReset);
    assertNoStartBit: assert property (propertyNoStartBit);
    assertCheckOutput: assert property (propertyCheckOutput);
    assertIn_idle_counter_not_enabled__step: assert property (in_idle_counter_not_enabled__step);
    assertIn_idle_counter_not_enabled__base: assert property (in_idle_counter_not_enabled__base);

endmodule

bind readserial readserial_properties inst_readserial_properties (.*);