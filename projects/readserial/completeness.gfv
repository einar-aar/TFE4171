// @lang=vli @ts=2

completeness readserial;
disable iff: (!reset_n); 
inputs: reset_n, rxd;

determination_requirements:
  determined(valid);
  if (valid) determined(data); endif;

reset_property:
  sva/inst_readserial_properties.propertyReset;
property_graph:
  sva/inst_readserial_properties.propertyReset -> sva/inst_readserial_properties.propertyNoStartBit;
  sva/inst_readserial_properties.propertyReset -> sva/inst_readserial_properties.propertyCheckOutput;

  sva/inst_readserial_properties.propertyNoStartBit -> sva/inst_readserial_properties.propertyNoStartBit;
  sva/inst_readserial_properties.propertyNoStartBit -> sva/inst_readserial_properties.propertyCheckOutput;

  sva/inst_readserial_properties.propertyCheckOutput -> sva/inst_readserial_properties.propertyNoStartBit;
  sva/inst_readserial_properties.propertyCheckOutput -> sva/inst_readserial_properties.propertyCheckOutput;
end completeness;
