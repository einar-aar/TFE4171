`default_nettype none

module fv_logic_unit_sequ #(
    parameter WIDTH = 16
)(
    input logic         rst,
    input logic         clk,
    // Inputs
    input [(WIDTH-1):0] req_vec,
    // Outputs
    input logic         out,
    // Valid signals
    input logic         valid,
    // Ready signals
    input logic         done
);

    // Define for every property the clock
    default clocking default_clk @(posedge clk); endclocking

	property verify_rst;
		rst |-> ((out == 0) && (done == 1));
	endproperty

	property verify_computation;
		(valid && done) |=> (!done)[*(WIDTH-1)] ##1 (out == ((|$past(req_vec[WIDTH-2:0], WIDTH)) && $past(req_vec[WIDTH-1], WIDTH))) && done;
	endproperty

	property done_low;
		(valid && done) |=> (!done)[*(WIDTH-1)];
	endproperty

	assert_verify_rst: assert property (verify_rst);
	assert_verify_computation: assert property (disable iff (rst) verify_computation);
	assert_done_low: assert property (disable iff (rst) done_low);

endmodule

bind logic_unit_sequ fv_logic_unit_sequ #(
    .WIDTH(WIDTH)
) fv_logic_unit_seq_i (
    .rst(rst),
    .clk(clk),
    .req_vec(req_vec),
    .out(out),
    .valid(valid),
    .done(done)
);
